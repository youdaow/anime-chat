# 复制成 .env 会被读取吗？——不会，本应用只认 环境变量 与 data/settings.json。
# 这里列出可用的环境变量（在 PowerShell 里： $env:ANIMECHAT_LLM_API_KEY = "sk-hub-xxxx"）
#
# 想开机自动带上，把下面几行放进 PowerShell 配置文件，或者用 setx 存成用户环境变量。

# 网关地址：默认已经指向同机的 AI API Hub（OpenAI 兼容）
ANIMECHAT_LLM_BASE_URL=http://127.0.0.1:8789/v1

# Hub 里创建的入口 Token（形如 sk-hub-...）。留空 = 内置 Mock 假模型，不联网也能跑通全流程
ANIMECHAT_LLM_API_KEY=

# auto 表示让 Hub 自己选路；也可以填具体模型名
ANIMECHAT_LLM_MODEL=auto

# 服务监听（只建议 127.0.0.1，这个界面没有鉴权）
ANIMECHAT_HOST=127.0.0.1
ANIMECHAT_PORT=8899

# 数据目录：聊天库、角色卡、表情包都放这里。换盘/多账号就改它
#ANIMECHAT_DATA_DIR=D:\animechat-data

# rich（积极甩图） / light（克制） / off（只用文字，模型主动发的仍显示）
ANIMECHAT_STICKER_MODE=rich

# 联网搜表情图：留空就走免 Key 的 DuckDuckGo；填了 Tenor/Giphy Key 效果更好
ANIMECHAT_STICKER_SEARCH_PROVIDER=auto
ANIMECHAT_TENOR_API_KEY=
ANIMECHAT_GIPHY_API_KEY=
