# 本应用认的环境变量清单。
# 先说清楚一件事：复制成 .env 不会被读取 —— 程序里没有 dotenv，只认真实环境变量
# 和 data/settings.json（界面上改设置写进去的就是它）。优先级：默认值 < settings.json < 环境变量。
# 所以密钥用环境变量注入，部署时不会被界面上的改动覆盖掉。
#
# PowerShell：  $env:ANIMECHAT_LLM_API_KEY = "sk-..."
# 想开机自动带上：把下面几行放进 PowerShell 配置文件，或用 setx 存成用户环境变量。
# 完整的可覆盖字段见 src/animechat/config.py 的 ENV_KEYS（这里只列用得上的一部分）。

# ---- 模型接入：Base URL + Key + 模型名，三格 ----
# 接入方式是 providers.py 那张注册表里的 key：
#   deepseek / qwen / glm / kimi / openai_official  —— 官方地址已预置，只填 Key
#   openai（默认值）                              —— 自定义 / 中转站，自己填 Base URL
#   mock                                          —— 内置假模型，不联网不花钱
# 选预置平台就别填地址，注册表会补上那家的官方 Base URL。
ANIMECHAT_LLM_PROVIDER=openai
# OpenAI 兼容协议都算。自建中转站常常就写 http://127.0.0.1:端口/v1，本机地址没什么特殊。
# 注意路径要带对版本段：多数平台 /v1，智谱是 /api/paas/v4。写错会 404 而不是「连不上」。
ANIMECHAT_LLM_BASE_URL=
ANIMECHAT_LLM_API_KEY=
# 模型名必须是对方 /v1/models 里真有的那个 id，留空会被当场拦下（不再兜底成默认值去撞 404）。
# 界面上点「测试连接」会拉一次真实清单让你选；命令行配的话先自己 curl 一次那个清单。
ANIMECHAT_LLM_MODEL=
# Key 空着 = 走内置 Mock（黄条会提示），所以「什么都不配」也是能跑的。

# ---- 服务监听 ----
# 这个界面没有鉴权，请保持 127.0.0.1，不要反向代理到公网。
ANIMECHAT_HOST=127.0.0.1
ANIMECHAT_PORT=8899

# ---- 数据目录：聊天库、角色卡、表情包都在这里。换盘 / 多账号就改它 ----
# 改了之后旧数据要自己拷过去。
#ANIMECHAT_DATA_DIR=D:\animechat-data

# ---- 表情包 ----
# rich（积极甩图）/ light（只在明显情绪时补）/ off（只用文字，模型主动发的仍显示）
ANIMECHAT_STICKER_MODE=rich
ANIMECHAT_MAX_STICKERS_PER_REPLY=1
# 联网搜图来源：auto = Bing → DuckDuckGo，两家都不要 Key，也不用注册。
# 实测这台机器上 Bing 更稳（DuckDuckGo 常被风控）；要锁定单一来源就填 bing 或 duckduckgo。
ANIMECHAT_STICKER_SEARCH_PROVIDER=auto

# ---- 上下文与回复长度 ----
# 上下文字符预算（太会长报 context_length_exceeded，就来调这格）
#ANIMECHAT_CONTEXT_CHARS=6000
# 最大回复 token。qwen3 / R1 这类混合推理模型把思考过程也算在这里，800 可能想完就截断、
# 正文一个字都没有 —— 用这类模型就把它调到 2000 以上。
#ANIMECHAT_LLM_MAX_TOKENS=800
# 思考开关：off 直接不让它想（实测聊天里 reasoning 模型 84% 的生成量烧在没人看的草稿上）
#ANIMECHAT_LLM_THINKING=off

# ---- 「我」是谁（会进系统提示词，角色因此知道你是谁）----
ANIMECHAT_USER_NAME=你
#ANIMECHAT_USER_NOTES=

# ---- GitHub 表情仓库：拉公开仓库不用 Token，发布（写）才需要 ----
# 写成 owner/仓库名，或 owner/仓库名:分支（分支默认 main）
#ANIMECHAT_GITHUB_REPO=
#ANIMECHAT_GITHUB_TOKEN=

# ---- 飞书桥接（单独进程：animechat feishu，窗口一关飞书就不回话）----
# App ID / Secret 在 open.feishu.cn 的「凭证与基础信息」。这两格填进网页设置也一样。
#ANIMECHAT_FEISHU_APP_ID=
#ANIMECHAT_FEISHU_APP_SECRET=
# 新绑定的私聊默认用哪个角色；空 = 角色库第一个，让用户在飞书里用 /角色 换
#ANIMECHAT_FEISHU_CHARACTER=
# 桥接进程回调本机 API 的地址，空 = 按 host/port 拼。只有跨机部署才需要填
#ANIMECHAT_FEISHU_API_BASE=
# 沉默后主动发言（总开关 + 多久算沉默 + 每天最多几条）
#ANIMECHAT_FEISHU_PROACTIVE=false
#ANIMECHAT_FEISHU_IDLE_MIN=120
#ANIMECHAT_FEISHU_DAILY_MAX=10
